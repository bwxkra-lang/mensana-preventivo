<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light only">
<title>Mensana · Costruisci il tuo preventivo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  :root{
    --terracotta:#C1633D;
    --terracotta-dark:#8F3E22;
    --sea:#3B6E77;
    --sea-deep:#1E3D42;
    --wood:#3E2E22;
    --cream:#FBF8F2;
    --cream-2:#F0E8D8;
    --ink:#1E1B16;
    --line:rgba(30,27,22,.14);
    --gold:#A5793D;
  }
  *{box-sizing:border-box;}
  html{color-scheme:light;background:#FBF8F2;}
  html,body{margin:0;padding:0;}
  body{
    background:#FBF8F2;
    color:var(--ink);
    font-family:'Lora', Georgia, serif;
    line-height:1.5;
    padding:0 0 80px;
  }
  .wrap{max-width:920px;margin:0 auto;padding:0 22px;background:#FBF8F2;}

  header.hero{
    padding:56px 22px 34px;
    text-align:center;
    border-bottom:1px solid var(--line);
    background:#F0E8D8;
  }
  .eyebrow{
    font-family:'Lora', serif;
    font-variant:small-caps;
    letter-spacing:.14em;
    font-size:12.5px;
    color:var(--sea-deep);
    text-transform:lowercase;
    margin-bottom:10px;
  }
  h1.brand{
    font-family:'Playfair Display', serif;
    font-weight:700;
    font-size:44px;
    letter-spacing:.02em;
    margin:0 0 6px;
    color:var(--wood);
  }
  h1.brand span{color:var(--terracotta);font-style:italic;font-weight:500;}
  .sub{
    max-width:520px;
    margin:0 auto;
    font-size:15.5px;
    color:#5c5548;
  }
  .flourish{display:flex;align-items:center;justify-content:center;gap:10px;margin:18px 0 4px;color:var(--gold);}
  .flourish .bar{width:60px;height:1px;background:var(--gold);opacity:.6;}

  section.block{
    padding:34px 22px;
    border-bottom:1px solid var(--line);
    background:#FBF8F2;
  }
  section.block:last-of-type{border-bottom:none;}
  .block-head{
    display:flex;
    align-items:baseline;
    gap:14px;
    margin-bottom:18px;
  }
  .block-num{
    font-family:'Playfair Display', serif;
    font-style:italic;
    color:var(--terracotta);
    font-size:15px;
    min-width:20px;
  }
  h2.block-title{
    font-family:'Playfair Display', serif;
    font-weight:600;
    font-size:23px;
    margin:0;
    color:var(--wood);
  }
  .block-note{font-size:13.5px;color:#7a7263;margin:-8px 0 18px 34px;}

  .guests-row{display:flex;gap:18px;flex-wrap:wrap;margin-left:34px;}
  .num-field{
    background:#fff;
    border:1px solid var(--line);
    border-radius:3px;
    padding:12px 14px;
    display:flex;
    flex-direction:column;
    gap:6px;
    min-width:150px;
    flex:1;
  }
  .num-field label{font-size:12.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--sea-deep);min-height:2.5em;line-height:1.25;display:flex;align-items:flex-start;}
  .num-field .stepper{display:flex;align-items:center;gap:10px;}
  .num-field button{
    width:28px;height:28px;border-radius:50%;border:1px solid var(--terracotta);
    background:#fff;color:var(--terracotta);font-size:16px;line-height:1;cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    transition:background .15s, color .15s;
  }
  .num-field button:hover{background:var(--terracotta);color:#fff;}
  .num-field input[type=number]{
    width:56px;border:none;text-align:center;font-family:'Lora',serif;font-size:19px;
    background:transparent;color:var(--ink);
    -moz-appearance:textfield;
  }
  .num-field input::-webkit-outer-spin-button,
  .num-field input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}

  .opt-list{margin-left:34px;display:flex;flex-direction:column;gap:2px;}
  .opt{
    display:flex;
    align-items:flex-start;
    gap:14px;
    padding:13px 14px;
    background:#fff;
    border:1px solid var(--line);
    border-radius:4px;
    cursor:pointer;
    transition:background .15s, border-color .15s, box-shadow .15s;
  }
  .opt:hover{background:#fdf6ef;border-color:var(--terracotta);}
  .opt.checked{
    background:#fff;
    border-color:var(--terracotta);
    border-width:1.5px;
    box-shadow:0 1px 4px rgba(46,42,37,.08);
  }
  .opt input{margin-top:4px;accent-color:var(--terracotta);width:16px;height:16px;flex-shrink:0;cursor:pointer;}
  .opt-body{flex:1;display:flex;justify-content:space-between;gap:14px;align-items:baseline;flex-wrap:wrap;}
  .opt-text .name{font-family:'Lora',serif;font-weight:600;font-size:15.5px;color:var(--ink);}
  .opt-text .tag{
    display:inline-block;margin-left:8px;font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;
    color:var(--terracotta-dark);border:1px solid var(--terracotta);border-radius:20px;padding:1px 8px;
    vertical-align:middle;
  }
  .opt-text .desc{font-size:13.5px;color:#6f6858;margin-top:3px;max-width:480px;}
  .opt-price{white-space:nowrap;font-family:'Lora',serif;font-size:15.5px;color:var(--sea-deep);font-weight:600;}
  .opt-price .u{font-size:11px;font-weight:400;color:#8a8272;margin-left:3px;}

  .radio-hint{font-size:12px;color:#a89f8c;margin:2px 0 8px 34px;font-style:italic;}

  /* summary sidebar-ish, sticky footer bar */
  .summary{
    position:sticky;
    bottom:0;
    margin-top:10px;
    background:var(--wood);
    color:#f3ead9;
    padding:20px 22px;
    box-shadow:0 -6px 24px rgba(0,0,0,.18);
  }
  .summary-inner{max-width:920px;margin:0 auto;}
  .summary-top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;}
  .summary-total-label{font-family:'Lora',serif;font-size:12.5px;text-transform:uppercase;letter-spacing:.08em;opacity:.75;}
  .summary-total{font-family:'Playfair Display',serif;font-size:34px;color:#fff;}
  .summary-total small{font-size:14px;font-weight:400;opacity:.7;font-family:'Lora',serif;}
  .summary-perhead{font-size:12.5px;opacity:.75;margin-top:2px;}
  .toggle-detail{
    background:none;border:1px solid rgba(255,255,255,.35);color:#f3ead9;border-radius:20px;
    padding:8px 18px;font-family:'Lora',serif;font-size:13px;cursor:pointer;
  }
  .toggle-detail:hover{border-color:#fff;}
  .pdf-btn{
    background:var(--terracotta);border:1px solid var(--terracotta);color:#fff;border-radius:20px;
    padding:8px 18px;font-family:'Lora',serif;font-size:13px;cursor:pointer;margin-left:8px;
  }
  .pdf-btn:hover{background:var(--terracotta-dark);border-color:var(--terracotta-dark);}

  .print-only{display:none;}
  @media print{
    .summary{position:static;box-shadow:none;}
    .toggle-detail, .pdf-btn, .num-field button{display:none !important;}
    .detail-list{max-height:none !important;margin-top:16px;}
    .print-only{display:block;}
    header.hero{background:#fff !important;}
    .opt input, .opt-price{display:none;}
    .opt.checked{border-color:var(--terracotta) !important;}
    .opt:not(.checked){display:none;}
    body{padding-bottom:0 !important;}
  }
  .print-header{
    text-align:center;padding:18px 22px;border-bottom:2px solid var(--terracotta);
    font-family:'Playfair Display',serif;color:var(--wood);
  }
  .print-header .addr{font-family:'Lora',serif;font-size:12px;color:#6f6858;margin-top:4px;}
  .print-footer{
    text-align:center;padding:16px 22px;font-size:11.5px;color:#6f6858;border-top:1px solid var(--line);
  }
  .detail-list{
    max-height:0;overflow:hidden;transition:max-height .25s ease;
  }
  .detail-list.open{max-height:600px;margin-top:16px;}
  .detail-row{
    display:flex;justify-content:space-between;font-size:13.5px;padding:5px 0;
    border-bottom:1px dashed rgba(255,255,255,.15);
  }
  .detail-row.empty{opacity:.6;font-style:italic;}

  .disclaimer{
    max-width:920px;margin:24px auto 0;padding:0 22px;
    font-size:12px;color:#8a8272;line-height:1.6;
  }
  .disclaimer b{color:var(--terracotta-dark);}

  @media (max-width:600px){
    h1.brand{font-size:34px;}
    .block-note, .guests-row, .opt-list, .radio-hint{margin-left:0;}
    .opt{padding:12px 10px;}
    .summary-total{font-size:27px;}
  }

  /* Rete di sicurezza: se il telefono segnala una preferenza per il tema scuro,
     forziamo comunque i colori chiari del brand, cosi' il documento resta leggibile. */
  @media (prefers-color-scheme: dark){
    html, body{background:#FBF8F2 !important; color:#1E1B16 !important;}
    .wrap, section.block{background:#FBF8F2 !important;}
    header.hero{background:#F0E8D8 !important;}
    h1.brand, h2.block-title{color:#3E2E22 !important;}
    .eyebrow{color:#1E3D42 !important;}
    .sub, .block-note{color:#5c5548 !important;}
    .opt{background:#fff !important; color:#1E1B16 !important;}
    .opt-text .name{color:#1E1B16 !important;}
    .num-field{background:#fff !important;}
    .summary{background:#3E2E22 !important; color:#f3ead9 !important;}
  }
</style>
</head>
<body>

<div class="print-only print-header">
  MENSANA · Masseria Urbana
  <div class="addr">Via del Quadrifoglio 12, Roma · parcheggio gratuito · <span id="print-date"></span></div>
</div>

<header class="hero">
  <div class="eyebrow">Mensana · Masseria Urbana · Roma</div>
  <h1 class="brand">Costruisci il tuo <span>preventivo</span></h1>
  <div class="flourish"><span class="bar"></span>◇<span class="bar"></span></div>
  <p class="sub">Spunta le opzioni che ti interessano: il totale si aggiorna in tempo reale. È una bozza indicativa — la condizioneremo insieme ai dettagli della tua data.</p>
</header>

<div class="wrap">

  <section class="block">
    <div class="block-head"><span class="block-num">01</span><h2 class="block-title">I tuoi invitati</h2></div>
    <p class="block-note">Gli adulti fino a 10 anni hanno il menu bambini; il pacchetto adulti è a persona.</p>
    <div class="guests-row">
      <div class="num-field">
        <label>Adulti</label>
        <div class="stepper">
          <button type="button" data-target="adulti" data-delta="-1">−</button>
          <input type="number" id="adulti" min="0" value="0">
          <button type="button" data-target="adulti" data-delta="1">+</button>
        </div>
      </div>
      <div class="num-field">
        <label>Bambini (fino a 10 anni)</label>
        <div class="stepper">
          <button type="button" data-target="bambini" data-delta="-1">−</button>
          <input type="number" id="bambini" min="0" value="0">
          <button type="button" data-target="bambini" data-delta="1">+</button>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="block-head"><span class="block-num">02</span><h2 class="block-title">Tipo di evento</h2></div>
    <p class="block-note">Con il catering completo o solo per il dopocena (bar e intrattenimento, senza cena).</p>
    <div class="opt-list" id="eventtype-list"></div>
  </section>

  <section class="block" id="section-servizio">
    <div class="block-head"><span class="block-num">03</span><h2 class="block-title">Formula di servizio</h2></div>
    <div class="radio-hint">Scegli come viene servita la cena</div>
    <div class="opt-list" id="service-list"></div>
    <p class="block-note" id="buffet-note" style="display:none;margin-top:12px;">Indica il numero di invitati per vedere lo spazio indicativo e l'eventuale quota minimo garantito.</p>
  </section>

  <section class="block" id="section-menu">
    <div class="block-head"><span class="block-num">04</span><h2 class="block-title">La formula di menu</h2></div>
    <p class="block-note">Tutti i menu includono coperto, acqua e 1 bottiglia di vino ogni 4 persone. Prezzo a persona (adulti).</p>
    <div class="radio-hint">Scegli una formula</div>
    <div class="opt-list" id="menu-list"></div>
  </section>

  <section class="block" id="section-cake">
    <div class="block-head"><span class="block-num">05</span><h2 class="block-title">Torta &amp; dolce finale</h2></div>
    <div class="radio-hint">Facoltativo — disponibile sia con il catering sia per un evento solo dopocena</div>
    <div class="opt-list" id="cake-list"></div>
  </section>

  <section class="block">
    <div class="block-head"><span class="block-num">06</span><h2 class="block-title">Bar</h2></div>
    <p class="block-note">Prezzo a persona su adulti.</p>
    <p class="block-note" id="bar-dopocena-note" style="display:none;">Per un evento solo dopocena il bar è la voce principale: scegli qui la formula per i tuoi ospiti.</p>
    <div class="radio-hint">Facoltativo — scegli una formula bar</div>
    <div class="opt-list" id="bar-list"></div>
  </section>

  <section class="block">
    <div class="block-head"><span class="block-num">07</span><h2 class="block-title">Musica, scenografia &amp; extra</h2></div>
    <p class="block-note">Puoi selezionare più voci insieme — utile anche per completare un pacchetto solo dopocena.</p>
    <div class="opt-list" id="extra-list"></div>
  </section>

  <div class="disclaimer">
    <b>Nota</b> — Questo configuratore fornisce una stima indicativa basata sul listino Mensana. Non include eventuali condizioni speciali per date o eventi particolari (es. serate a tema), servizi "da quotare" (fotografo, esclusiva) o consumi extra alla carta. La quota "minimo garantito" per il buffet e lo spazio indicato sono orientativi e vanno confermati con l'amministrazione in base alla disponibilità. Il preventivo definitivo sarà confermato dal team Mensana.
  </div>
</div>

<div class="summary">
  <div class="summary-inner">
    <div class="summary-top">
      <div>
        <div class="summary-total-label">Totale stimato</div>
        <div class="summary-total">€ <span id="totalValue">0</span> <small>indicativo</small></div>
        <div class="summary-perhead" id="perHead"></div>
      </div>
      <button class="toggle-detail" id="toggleDetail">Vedi il dettaglio ▾</button>
      <button class="pdf-btn" id="downloadPdf">Scarica il preventivo in PDF</button>
    </div>
    <div class="detail-list" id="detailList"></div>
  </div>
</div>

<div class="print-only print-footer">
  Preventivo indicativo e provvisorio — non costituisce conferma di prenotazione. Il preventivo definitivo dovrà essere approvato dall'amministrazione Mensana in base alla disponibilità della data.
</div>

<script>
const eventTypeOptions = [
  {id:'cena', name:'Cena', price:0, unit:'', desc:'Evento completo con menu, torta e dolce come da formule Mensana.'},
  {id:'dopocena', name:'Dopocena', price:0, unit:'', desc:'Nessun menu cibo: solo bar, musica ed eventuale scenografia — ideale per feste serali senza cena.'},
];

const serviceOptions = [
  {id:'servito', name:'Servito al tavolo', price:0, unit:'', desc:'Formula classica: si paga in base al numero reale di invitati, nessuna quota aggiuntiva.'},
  {id:'buffet', name:'Buffet', price:0, unit:'', desc:'Prevede una quota "minimo garantito" quando il numero di invitati è inferiore alla capienza della sala assegnata — vedi il dettaglio qui sotto.'},
];

const buffetTiers = [
  {cap:25, elasticMax:28, label:'una parte della nostra sala interna'},
  {cap:50, label:'tutta una nostra sala'},
  {cap:80, label:'tutta la parte interna'},
  {cap:130, label:'tutto il locale'},
];

function getBuffetTier(guests){
  for (const t of buffetTiers) {
    if (guests <= (t.elasticMax || t.cap)) return t;
  }
  return buffetTiers[buffetTiers.length - 1];
}

const menuOptions = [
  {id:'completa', name:'L’Esperienza Completa', tag:'Consigliata', price:45, desc:'Antipasti + 2 Primi + Secondo + Contorno'},
  {id:'classico', name:'Il Grande Classico', tag:'La più richiesta', price:40, desc:'Antipasti + 1 Primo + Secondo + Contorno'},
  {id:'light', name:'I Menu Light', tag:null, price:35, desc:'Antipasti + 2 Primi oppure Antipasti + Secondo + Contorno'},
];

const cakeOptions = [
  {id:'benvenuto', name:'Il Benvenuto della Masseria', price:6, unit:'a persona', desc:'Aperitivo di benvenuto per tutti gli invitati.'},
  {id:'zeropensieri', name:'La Formula "Zero Pensieri"', price:7, unit:'a persona', desc:'Torta artigianale del Pasticcere Salentino Donato: ordine, trasporto, conservazione e servizio inclusi.'},
  {id:'tagliotorta', name:'Taglio torta (portata dall’esterno)', price:2, unit:'a persona', desc:'Se preferisci portare la torta tu: gestione e taglio, con scontrino e lista allergeni.'},
  {id:'dolcefinale', name:'Il nostro tiramisù, frutta o pasticciotto', price:5, unit:'a persona', desc:'Un dolce uguale per tutti a fine cena.'},
  {id:'buffetmignon', name:'Gran Buffet di mignon', price:6, unit:'a persona', desc:'In alternativa al dolce singolo, un buffet di mignon assortiti.'},
];

const barOptions = [
  {id:'openwine', name:'Open Wine', price:18, unit:'a persona', desc:'Vino bianco e rosso della casa illimitato per tutta la serata.'},
  {id:'openbar', name:'Open Bar Completo', price:28, unit:'a persona', desc:'Wine Bar illimitato più Cocktail Bar completo con cocktail d’autore.'},
  {id:'openbarfrutta', name:'Open Bar & Buffet di frutta', price:33, unit:'a persona', desc:'Open Bar Completo con l’aggiunta del buffet di frutta fresca.'},
];

const extraOptions = [
  {id:'dj', name:'DJ Set · Piano Bar · Karaoke', price:350, unit:'a servizio', flat:true, desc:'Intrattenimento con impianto audio professionale e pratiche SIAE incluse.'},
  {id:'pizzica', name:'Ballerine di Pizzica e Taranta', price:500, unit:'a spettacolo', flat:true, desc:'Spettacolo con le ballerine guidate dalla maestra Azzurra.'},
  {id:'scenografia', name:'Scenografia visiva', price:11, unit:'a persona (da)', desc:'Inviti, menu stampati, centrotavola, bomboniere e palloncini.'},
  {id:'hostess', name:'Hostess & Sicurezza all’ingresso', price:150, unit:'a servizio', flat:true, desc:'Selezione e ordine all’ingresso in caso di esclusiva.'},
];

const state = {
  adulti: 0,
  bambini: 0,
  eventType: 'cena',
  service: 'servito',
  menu: 'classico',
  cake: {},
  bar: null,
  extra: {},
};

function euro(n){
  return n.toLocaleString('it-IT', {maximumFractionDigits:0});
}

function renderRadioList(container, options, selectedKey, groupName, onSelect, nullable, hidePrice){
  container.innerHTML = '';
  options.forEach(opt => {
    const row = document.createElement('label');
    row.className = 'opt' + (selectedKey === opt.id ? ' checked' : '');
    const priceLabel = opt.flat ? euro(opt.price) : euro(opt.price);
    const unitLabel = opt.unit || 'a persona';
    row.innerHTML = `
      <input type="radio" name="${groupName}" ${selectedKey === opt.id ? 'checked' : ''}>
      <div class="opt-body">
        <div class="opt-text">
          <span class="name">${opt.name}</span>${opt.tag ? `<span class="tag">${opt.tag}</span>` : ''}
          <div class="desc">${opt.desc}</div>
        </div>
        ${hidePrice ? '' : `<div class="opt-price">€ ${priceLabel}<span class="u">${unitLabel}</span></div>`}
      </div>`;
    row.querySelector('input').addEventListener('change', () => {
      onSelect(nullable && selectedKey === opt.id ? null : opt.id);
      render();
    });
    if (nullable) {
      row.addEventListener('click', (e) => {
        if (selectedKey === opt.id && e.target.tagName !== 'INPUT') {
          onSelect(null);
          render();
        }
      });
    }
    container.appendChild(row);
  });
}

function renderCheckList(container, options, selectedMap, onToggle){
  container.innerHTML = '';
  options.forEach(opt => {
    const checked = !!selectedMap[opt.id];
    const row = document.createElement('label');
    row.className = 'opt' + (checked ? ' checked' : '');
    const unitLabel = opt.unit || 'a persona';
    row.innerHTML = `
      <input type="checkbox" ${checked ? 'checked' : ''}>
      <div class="opt-body">
        <div class="opt-text">
          <span class="name">${opt.name}</span>${opt.tag ? `<span class="tag">${opt.tag}</span>` : ''}
          <div class="desc">${opt.desc}</div>
        </div>
        <div class="opt-price">€ ${euro(opt.price)}<span class="u">${unitLabel}</span></div>
      </div>`;
    row.querySelector('input').addEventListener('change', (e) => {
      onToggle(opt.id, e.target.checked);
      render();
    });
    container.appendChild(row);
  });
}

function computeTotal(){
  const guests = state.adulti + state.bambini;
  let total = 0;
  const lines = [];
  const isCena = state.eventType === 'cena';
  const buffetTag = '';

  // Menu (only for "cena")
  if (isCena) {
    const menuOpt = menuOptions.find(m => m.id === state.menu);
    if (menuOpt && state.adulti > 0) {
      const sub = menuOpt.price * state.adulti;
      total += sub;
      lines.push({label: `${menuOpt.name} × ${state.adulti} adulti`, value: sub});
    }
    if (state.bambini > 0) {
      const sub = 25 * state.bambini;
      total += sub;
      lines.push({label: `Menu Bambini${buffetTag} × ${state.bambini}`, value: sub});
    }

    // Quota minimo garantito — solo per il buffet
    if (state.service === 'buffet' && guests > 0) {
      const tier = getBuffetTier(guests);
      const diff = Math.max(0, tier.cap - guests);
      if (diff > 0) {
        const sub = diff * 20;
        total += sub;
        lines.push({label: `Quota minimo garantito — spazio indicativo: ${tier.label}, per ${guests} partecipanti minimo garantiti`, value: sub});
      }
    }
  }

  // Cake — disponibile sia con catering sia con dopocena
  cakeOptions.forEach(opt => {
    if (state.cake[opt.id]) {
      const sub = opt.price * guests;
      total += sub;
      lines.push({label: `${opt.name} × ${guests} invitati`, value: sub});
    }
  });

  // Bar — prezzo a persona sui soli adulti
  const barOpt = barOptions.find(b => b.id === state.bar);
  if (barOpt && state.adulti > 0) {
    const sub = barOpt.price * state.adulti;
    total += sub;
    lines.push({label: `${barOpt.name} × ${state.adulti} adulti`, value: sub});
  }

  // Extra
  extraOptions.forEach(opt => {
    if (state.extra[opt.id]) {
      const sub = opt.flat ? opt.price : opt.price * guests;
      total += sub;
      lines.push({label: opt.flat ? opt.name : `${opt.name} × ${guests} invitati`, value: sub});
    }
  });

  return {total, lines, guests};
}

function render(){
  renderRadioList(document.getElementById('eventtype-list'), eventTypeOptions, state.eventType, 'eventtype', (v) => state.eventType = v, false, true);
  renderRadioList(document.getElementById('service-list'), serviceOptions, state.service, 'service', (v) => state.service = v, false, true);
  renderRadioList(document.getElementById('menu-list'), menuOptions, state.menu, 'menu', (v) => state.menu = v, false);
  renderCheckList(document.getElementById('cake-list'), cakeOptions, state.cake, (id, v) => state.cake[id] = v);
  renderRadioList(document.getElementById('bar-list'), barOptions, state.bar, 'bar', (v) => state.bar = v, true);
  renderCheckList(document.getElementById('extra-list'), extraOptions, state.extra, (id, v) => state.extra[id] = v);

  const isCena = state.eventType === 'cena';
  document.getElementById('section-servizio').style.display = isCena ? '' : 'none';
  document.getElementById('section-menu').style.display = isCena ? '' : 'none';
  document.getElementById('buffet-note').style.display = (isCena && state.service === 'buffet') ? '' : 'none';
  if (isCena && state.service === 'buffet') {
    const guests = state.adulti + state.bambini;
    const noteEl = document.getElementById('buffet-note');
    if (guests > 0) {
      const tier = getBuffetTier(guests);
      const diff = Math.max(0, tier.cap - guests);
      const feeText = diff > 0 ? `per ${guests} partecipanti minimo garantiti, la differenza da pagare per il buffet è di € ${euro(diff * 20)}` : `per ${guests} partecipanti minimo garantiti, nessuna differenza da pagare`;
      noteEl.innerHTML = `Spazio indicativo: <b>${tier.label}</b> (fino a ${tier.cap} persone) — ${feeText}. Da confermare con l'amministrazione in base alla disponibilità.`;
    } else {
      noteEl.textContent = 'Indica il numero di invitati qui sopra per vedere lo spazio indicativo e l\'eventuale quota minimo garantito.';
    }
  }
  document.getElementById('bar-dopocena-note').style.display = isCena ? 'none' : '';

  const {total, lines, guests} = computeTotal();
  document.getElementById('totalValue').textContent = euro(total);
  document.getElementById('perHead').textContent = guests > 0
    ? `≈ € ${euro(Math.round(total / guests))} a persona · ${guests} invitati totali`
    : 'Aggiungi almeno un invitato';

  const detailEl = document.getElementById('detailList');
  detailEl.innerHTML = '';
  if (lines.length === 0) {
    detailEl.innerHTML = '<div class="detail-row empty">Nessuna voce selezionata ancora</div>';
  } else {
    lines.forEach(l => {
      const row = document.createElement('div');
      row.className = 'detail-row';
      row.innerHTML = `<span>${l.label}</span><span>€ ${euro(l.value)}</span>`;
      detailEl.appendChild(row);
    });
  }
  if (typeof adjustBodyPadding === 'function') adjustBodyPadding();
}

document.querySelectorAll('.num-field button').forEach(btn => {
  btn.addEventListener('click', () => {
    const target = btn.dataset.target;
    const delta = parseInt(btn.dataset.delta, 10);
    const input = document.getElementById(target);
    let val = Math.max(0, (parseInt(input.value, 10) || 0) + delta);
    input.value = val;
    state[target] = val;
    render();
  });
});
['adulti','bambini'].forEach(id => {
  document.getElementById(id).addEventListener('input', (e) => {
    let v = Math.max(0, parseInt(e.target.value, 10) || 0);
    state[id] = v;
    render();
  });
});

document.getElementById('toggleDetail').addEventListener('click', () => {
  const el = document.getElementById('detailList');
  const btn = document.getElementById('toggleDetail');
  el.classList.toggle('open');
  btn.textContent = el.classList.contains('open') ? 'Nascondi il dettaglio ▴' : 'Vedi il dettaglio ▾';
  adjustBodyPadding();
});

function adjustBodyPadding(){
  const summary = document.querySelector('.summary');
  // +24 di margine di sicurezza cosi' la barra scura non copre mai il contenuto sopra
  document.body.style.paddingBottom = (summary.offsetHeight + 24) + 'px';
}
window.addEventListener('resize', adjustBodyPadding);

function buildPdfContent(){
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF('p', 'pt', 'a4');
  const {total, lines} = computeTotal();
  const pageWidth = doc.internal.pageSize.getWidth();
  const pageHeight = doc.internal.pageSize.getHeight();
  const margin = 44;
  let y = 56;

  doc.setFont('times', 'bold');
  doc.setFontSize(18);
  doc.setTextColor(62, 46, 34);
  doc.text('MENSANA · Masseria Urbana', pageWidth / 2, y, {align: 'center'});
  y += 18;
  doc.setFont('times', 'normal');
  doc.setFontSize(10);
  doc.setTextColor(111, 104, 88);
  const dateStr = new Date().toLocaleDateString('it-IT', {day: '2-digit', month: 'long', year: 'numeric'});
  doc.text(`Via del Quadrifoglio 12, Roma · parcheggio gratuito · ${dateStr}`, pageWidth / 2, y, {align: 'center'});
  y += 12;
  doc.setDrawColor(193, 99, 61);
  doc.setLineWidth(1.5);
  doc.line(margin, y, pageWidth - margin, y);
  y += 28;

  const isCena = state.eventType === 'cena';
  const tipoText = isCena ? `Cena (${state.service === 'buffet' ? 'Buffet' : 'Servito al tavolo'})` : 'Dopocena';
  let invitatiLine = `Invitati: ${state.adulti} adulti`;
  if (state.bambini > 0) invitatiLine += ` + ${state.bambini} bambini`;
  invitatiLine += `   ·   Tipo di evento: ${tipoText}`;
  doc.setFont('times', 'normal');
  doc.setFontSize(11.5);
  doc.setTextColor(30, 27, 22);
  doc.text(invitatiLine, margin, y);
  y += 26;

  doc.setFontSize(10.5);
  if (lines.length === 0) {
    doc.setTextColor(150, 150, 150);
    doc.text('Nessuna voce selezionata', margin, y);
    y += 20;
  } else {
    lines.forEach(l => {
      if (y > pageHeight - 120) { doc.addPage(); y = 56; }
      doc.setTextColor(30, 27, 22);
      doc.text(l.label, margin, y, {maxWidth: pageWidth - margin * 2 - 90});
      doc.text(`€ ${euro(l.value)}`, pageWidth - margin, y, {align: 'right'});
      doc.setDrawColor(220, 220, 220);
      doc.setLineWidth(0.5);
      y += 12;
      doc.line(margin, y, pageWidth - margin, y);
      y += 16;
    });
  }

  if (y > pageHeight - 140) { doc.addPage(); y = 56; }
  y += 8;
  doc.setDrawColor(62, 46, 34);
  doc.setLineWidth(1.5);
  doc.line(margin, y, pageWidth - margin, y);
  y += 26;
  doc.setFont('times', 'bold');
  doc.setFontSize(16);
  doc.setTextColor(30, 27, 22);
  doc.text(`Totale stimato: € ${euro(total)}`, pageWidth - margin, y, {align: 'right'});
  y += 34;

  doc.setFont('times', 'normal');
  doc.setFontSize(9);
  doc.setTextColor(111, 104, 88);
  const disclaimer = "Preventivo indicativo e provvisorio — non costituisce conferma di prenotazione. Il preventivo definitivo dovra' essere approvato dall'amministrazione Mensana in base alla disponibilita' della data.";
  const disclaimerLines = doc.splitTextToSize(disclaimer, pageWidth - margin * 2);
  doc.text(disclaimerLines, margin, y);

  doc.save('Mensana-preventivo.pdf');
}

document.getElementById('downloadPdf').addEventListener('click', () => {
  if (!window.jspdf) {
    alert('Il generatore PDF non si e\' caricato (serve connessione internet). Riprova tra un istante.');
    return;
  }
  buildPdfContent();
});

render();
adjustBodyPadding();
// ricalcola dopo che il transition del dettaglio e' finito (l'altezza cambia gradualmente)
document.getElementById('detailList').addEventListener('transitionend', adjustBodyPadding);
</script>

</body>
</html>
